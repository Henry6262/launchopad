# Electric Relic V1
# Copy the values you intend to configure into `.env.local`.
# Never expose service-role, Helius, or Pinata credentials with NEXT_PUBLIC_.

# Public site origin used for canonical social metadata.
NEXT_PUBLIC_SITE_URL=

# Public wallet connection. Defaults to Solana devnet when omitted. The
# Pump Lab never sends or returns a transaction.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Server-side Pump inspection and simulation. The local `npm run canary`
# operator also reads ELECTRIC_RELIC_SOLANA_DEVNET_RPC_URL unless `--rpc` is
# passed. The harness verifies the devnet genesis hash and must never run in
# Vercel or receive a hosted signer. Public cluster RPC is rate-limited.
ELECTRIC_RELIC_SOLANA_DEVNET_RPC_URL=
# Mainnet remains read-only in V1; the canary rejects the mainnet genesis hash.
ELECTRIC_RELIC_SOLANA_MAINNET_RPC_URL=
# Required on every deployed build before the RPC-backed simulator will run.
# Generate a high-entropy server-only value and enter it only in the private
# Pump Lab access field; it is never a wallet secret.
ELECTRIC_RELIC_PUMP_PREFLIGHT_ACCESS_KEY=
ELECTRIC_RELIC_PUMP_PREFLIGHT_RATE_LIMIT_MAX=6
ELECTRIC_RELIC_PUMP_PREFLIGHT_RATE_LIMIT_WINDOW_SECONDS=60
# There is deliberately no mainnet-write flag in V1. Signing/broadcast remains
# absent until the canary gates are approved.

# Server-side creator application persistence.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ELECTRIC_RELIC_APPLICATIONS_TABLE=electric_relic_creator_applications
ELECTRIC_RELIC_WORLDS_TABLE=electric_relic_world_catalog

# Server-side, read-only MPL-Hybrid reconciliation.
ELECTRIC_RELIC_SOLANA_RPC_URL=
# Signed launch artifacts should use ipfs:// or ar://. If an HTTPS artifact is
# unavoidable, list its exact hostname here (comma-separated); all other HTTPS
# artifact hosts fail closed.
ELECTRIC_RELIC_SIGNED_ARTIFACT_HOSTS=

# Server-side indexed activity.
HELIUS_API_KEY=
ELECTRIC_RELIC_ACTIVITY_CACHE_SECONDS=15

# Process-local public API abuse protection. Keep the secret server-only so
# client network identifiers are stored only as keyed fingerprints.
ELECTRIC_RELIC_RATE_LIMIT_SECRET=
ELECTRIC_RELIC_APPLICATION_RATE_LIMIT_MAX=5
ELECTRIC_RELIC_APPLICATION_RATE_LIMIT_WINDOW_SECONDS=900
ELECTRIC_RELIC_ACTIVITY_RATE_LIMIT_MAX=60
ELECTRIC_RELIC_ACTIVITY_RATE_LIMIT_WINDOW_SECONDS=60

# Server-side public IPFS uploads.
PINATA_JWT=
PINATA_GATEWAY_HOST=
ELECTRIC_RELIC_IPFS_MAX_BYTES=10485760
# Required in addition to PINATA_JWT. Used only by the assisted internal
# uploader; do not expose it to client code.
ELECTRIC_RELIC_IPFS_UPLOAD_TOKEN=
