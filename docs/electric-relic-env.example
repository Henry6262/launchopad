# Electric Relic V1 — server-only environment variables
#
# Copy only the values you intend to configure into `.env.local`.
# Never prefix service-role, Helius, or Pinata credentials with NEXT_PUBLIC_.
# Empty values intentionally keep the corresponding integration unavailable.

# Creator applications (Supabase REST)
# Required together. The table defaults are not guessed by the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ELECTRIC_RELIC_APPLICATIONS_TABLE=electric_relic_creator_applications
ELECTRIC_RELIC_WORLDS_TABLE=electric_relic_world_catalog

# Read-only Solana / MPL-Hybrid client
# Must match the manifest cluster: devnet during testing, mainnet-beta only
# after every signed-covenant gate passes.
ELECTRIC_RELIC_SOLANA_RPC_URL=
# Prefer content-addressed ipfs:// or ar:// signed launch artifacts. Optional
# comma-separated exact hostnames allow exceptional HTTPS artifact locations.
ELECTRIC_RELIC_SIGNED_ARTIFACT_HOSTS=

# Pump provenance reads and simulation-only SDK preflight
ELECTRIC_RELIC_SOLANA_DEVNET_RPC_URL=
ELECTRIC_RELIC_SOLANA_MAINNET_RPC_URL=
# Mandatory on deployed builds. This protects the expensive RPC simulator
# across serverless instances; never expose it through NEXT_PUBLIC_*.
ELECTRIC_RELIC_PUMP_PREFLIGHT_ACCESS_KEY=
ELECTRIC_RELIC_PUMP_PREFLIGHT_RATE_LIMIT_MAX=6
ELECTRIC_RELIC_PUMP_PREFLIGHT_RATE_LIMIT_WINDOW_SECONDS=60
# No variable enables Pump signing or broadcast in V1. The server never returns
# transaction bytes from the preflight endpoint.

# Helius transaction activity
# The adapter derives its devnet/mainnet RPC endpoint from the requested cluster.
HELIUS_API_KEY=
# Shared server/edge cache lifetime. Valid range: 5–300 seconds.
ELECTRIC_RELIC_ACTIVITY_CACHE_SECONDS=15

# Public API abuse protection. This secret keys client fingerprints and must
# remain server-only. Generate an independent high-entropy production value.
ELECTRIC_RELIC_RATE_LIMIT_SECRET=
# Defaults shown below; invalid/out-of-range values fail back to these defaults.
ELECTRIC_RELIC_APPLICATION_RATE_LIMIT_MAX=5
ELECTRIC_RELIC_APPLICATION_RATE_LIMIT_WINDOW_SECONDS=900
ELECTRIC_RELIC_ACTIVITY_RATE_LIMIT_MAX=60
ELECTRIC_RELIC_ACTIVITY_RATE_LIMIT_WINDOW_SECONDS=60

# Public IPFS uploads through Pinata V3
PINATA_JWT=
# Optional, e.g. example-gateway.mypinata.cloud (host only; no protocol/path).
PINATA_GATEWAY_HOST=
# Defaults to 10 MiB when omitted.
ELECTRIC_RELIC_IPFS_MAX_BYTES=10485760
# Required by the upload API in addition to PINATA_JWT. This is an internal
# assisted-launch bearer token and must never be sent to public browser code.
ELECTRIC_RELIC_IPFS_UPLOAD_TOKEN=
